{
  "name": "real-world-framework-versions",
  "private": true,
  "type": "module",
  "dependencies": {
    "@sankyu/react-circle-flags": "*",
    "@sankyu/solid-circle-flags": "*",
    "@sankyu/svelte-circle-flags": "*",
    "@sankyu/vue-circle-flags": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-js": "^1.9.17",
    "svelte": "^5.57.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "webpack": "^5.112.2"
  },
  "realWorld": {
    "variants": {
      "react-16.8": {
        "env": {
          "FRAMEWORK": "react"
        },
        "dependencies": {
          "react": "16.8.0",
          "react-dom": "16.8.0"
        }
      },
      "react-17": {
        "env": {
          "FRAMEWORK": "react"
        },
        "dependencies": {
          "react": "^17.0.2",
          "react-dom": "^17.0.2"
        }
      },
      "react-18": {
        "env": {
          "FRAMEWORK": "react"
        },
        "dependencies": {
          "react": "^18.3.1",
          "react-dom": "^18.3.1"
        }
      },
      "react-19": {
        "env": {
          "FRAMEWORK": "react"
        }
      },
      "vue-3.5.0": {
        "env": {
          "FRAMEWORK": "vue"
        },
        "dependencies": {
          "vue": "3.5.0"
        }
      },
      "solid-1.9.0": {
        "env": {
          "FRAMEWORK": "solid"
        },
        "dependencies": {
          "solid-js": "1.9.0"
        }
      },
      "svelte-5.0.0": {
        "env": {
          "FRAMEWORK": "svelte"
        },
        "dependencies": {
          "svelte": "5.0.0"
        },
        "devDependencies": {
          "@sveltejs/vite-plugin-svelte": "^6.2.4",
          "vite": "^7.3.1"
        }
      }
    }
  }
}
